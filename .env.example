# Database - Required
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# AI - Set in Vercel env vars, never commit real keys!
# Get Gemini key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
AI_ARENA_API_KEY=your_ai_arena_key_here
FLAZ_API_KEY=your_flaz_key_here
AI_ARENA_BASE_URL=https://ai.flaz.id/v1

# Optional AI providers
OPENAI_API_KEY=your_openai_key_here
OPENROUTER_API_KEY=your_openrouter_key_here
GROQ_API_KEY=your_groq_key_here
TOGETHER_API_KEY=your_together_key_here

# Movies - Optional, if not set uses hardcoded 150+ real IDs
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_BEARER_TOKEN=your_tmdb_bearer_token_here

# Auth
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
